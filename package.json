{
  "name": "@saaskit-dev/acp-runtime",
  "version": "0.1.1",
  "packageManager": "bun@1.3.14",
  "description": "Product-facing, product-agnostic ACP runtime with runtime agent launch helpers.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal/agent-launch-registry": {
      "types": "./dist/internal/agent-launch-registry.d.ts",
      "import": "./dist/internal/agent-launch-registry.js"
    },
    "./internal/launch-config": {
      "types": "./dist/internal/launch-config.d.ts",
      "import": "./dist/internal/launch-config.js"
    },
    "./internal/simulator-workspace": {
      "types": "./dist/internal/simulator-workspace.d.ts",
      "import": "./dist/internal/simulator-workspace.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/internal",
    "dist/runtime",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist packages/simulator-agent/dist packages/simulator-agent/dist-bin .tmp harness-outputs .simulator-agent-acp-harness tmp-output.txt",
    "build": "bun run --cwd packages/simulator-agent build && bun run build:self",
    "build:self": "bun run build:lib && bun run build:examples && bun run build:harness",
    "build:lib": "bunx tsc -p tsconfig.json",
    "build:examples": "bunx tsc -p tsconfig.examples.json",
    "build:harness": "bunx tsc -p tsconfig.harness.json",
    "build:simulator-binary": "node scripts/build-simulator-binary.mjs",
    "dev": "bun run build:lib -- --watch",
    "harness:clean-outputs": "bun dist/harness/clean-outputs.js",
    "harness:check-admission": "bun dist/harness/run-agent-matrix.js --gate admission",
    "harness:run-agent": "bun dist/harness/run-agent-matrix.js --gate full",
    "predemo:client-sdk": "bun run build",
    "demo:client-sdk": "bun dist/examples/client-sdk-demo.js",
    "preruntime:claude": "bun run build",
    "runtime:claude": "bun dist/runtime/cli/runtime-command.js claude-acp",
    "preruntime": "bun run build",
    "runtime": "bun dist/runtime/cli/runtime-command.js",
    "test": "bun run --cwd packages/simulator-agent build && bun run --cwd packages/simulator-agent test && bunx vitest run",
    "test:watch": "bunx vitest",
    "lint": "bunx tsc --noEmit -p tsconfig.json && bun run build:lib && bunx tsc --noEmit -p tsconfig.examples.json && bunx tsc --noEmit -p tsconfig.harness.json",
    "prepublishOnly": "bun run build && bun run test"
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "ai-agent",
    "runtime",
    "testing",
    "regression",
    "fault-injection",
    "session",
    "claude",
    "codex",
    "gemini"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/tar": "^7.0.87",
    "@types/unzipper": "^0.10.11",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.20.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.215.0",
    "@opentelemetry/sdk-logs": "0.215.0",
    "@opentelemetry/sdk-trace-base": "^1.9.1",
    "tar": "^7.5.13",
    "unzipper": "^0.12.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saaskit-dev/acp-runtime.git"
  },
  "homepage": "https://github.com/saaskit-dev/acp-runtime#readme",
  "bugs": {
    "url": "https://github.com/saaskit-dev/acp-runtime/issues"
  },
  "workspaces": [
    "packages/*"
  ]
}
