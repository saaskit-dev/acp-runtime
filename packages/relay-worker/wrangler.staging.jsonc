// Staging environment configuration for ACP Relay Worker.
// Deploy with: pnpm --filter @saaskit-dev/acp-relay-worker run deploy:staging
//
// Required secrets (set via `wrangler secret put`):
//   ACP_RELAY_ACCOUNT_SESSION_SECRET  - HMAC key for account session tokens
//   ACP_RELAY_CONTROL_PLANE_SECRET    - Bearer token for control-plane API
//   ACP_RELAY_TICKET_PRIVATE_KEY      - Ed25519 PKCS#8 private key for ticket signing
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acp-relay-worker-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-27",
  "durable_objects": {
    "bindings": [
      {
        "class_name": "AcpRelayShard",
        "name": "ACP_RELAY_SHARDS"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["AcpRelayShard"],
      "tag": "v1"
    }
  ],
  "d1_databases": [
    {
      "binding": "ACP_RELAY_DB",
      "database_name": "acp-relay-staging",
      "database_id": "replace-with-staging-d1-database-id"
    }
  ],
  "vars": {
    "ACP_RELAY_CLIENT_RECONNECT_GRACE_MS": "86400000",
    "ACP_RELAY_DAEMON_RECONNECT_GRACE_MS": "86400000",
    "ACP_RELAY_HEARTBEAT_INTERVAL_MS": "30000",
    "ACP_RELAY_HEARTBEAT_TIMEOUT_MS": "45000",
    "ACP_RELAY_MAX_BUFFERED_FRAMES_PER_CONNECTION": "64",
    "ACP_RELAY_MAX_CONNECTIONS_PER_ACCOUNT": "16",
    "ACP_RELAY_TICKET_KID": "relay-staging",
    "ACP_RELAY_TICKET_RENEW_BEFORE_MS": "300000",
    "ACP_RELAY_TICKET_TTL_MS": "3600000"
  },
  "observability": {
    "enabled": true
  }
}
