{
  "name": "@saaskit-dev/acp-relay-worker",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "db:migrations:apply:local": "wrangler d1 migrations apply acp-relay --local",
    "db:migrations:apply:remote": "wrangler d1 migrations apply acp-relay --remote",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
